# ── データソース ──
# supabase: Supabase Auth + PostgreSQL(本番・ステージング)
# memory  : 認証不要のデモモード。E2E とローカル確認用。Supabase 未設定時の既定(再起動で消える)
# local   : memory と同じく認証不要で、学習データを LEXIGREP_LOCAL_DATA に保存する(手元専用)
LEXIGREP_DATA_SOURCE=memory
# local モードの保存先(既定 .lexigrep/learning.json)
# LEXIGREP_LOCAL_DATA=

# ── Supabase(LEXIGREP_DATA_SOURCE=supabase のとき必須) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── コンテンツ投入(scripts/import-subject.ts のみ。アプリには渡さない) ──
SUPABASE_SERVICE_ROLE_KEY=

# ── コンテンツ生成バッチ(pipeline/generate.ts のみ) ──
ANTHROPIC_API_KEY=
