{
  "name": "lexigrep",
  "version": "0.1.0",
  "private": true,
  "description": "英語の公式ドキュメントの実文から頻出パターンを学ぶ、間隔反復の学習プラットフォーム",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "content:init": "tsx scripts/init-subject.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:import": "tsx scripts/import-subject.ts",
    "content:review": "tsx pipeline/review.ts",
    "pipeline:crawl": "tsx pipeline/crawl.ts",
    "pipeline:frequency": "tsx pipeline/frequency.ts",
    "pipeline:generate": "tsx pipeline/generate.ts",
    "pipeline:verify": "tsx pipeline/verify.ts",
    "prepare": "husky",
    "pipeline:author": "tsx pipeline/author.ts"
  },
  "packageManager": "pnpm@10.30.1",
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "geist": "^1.9.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "ts-fsrs": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "robots-parser": "^3.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
